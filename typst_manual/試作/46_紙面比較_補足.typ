  columns: (20%, 26%, 34%, 20%),
  inset: (x: 5pt, y: 7pt), stroke: 0.5pt + rgb("c9d2d9"),
  table.header([*項目*], [*適用する条件*], [*処理・結果*], [*詳しい説明*]),
  [出血], [ラウンド終了時], [現在の出血値に等しいHPダメージ。通常は処理後に値を半分にし、端数を切り捨てます。], [本ページ「通常の処理」],

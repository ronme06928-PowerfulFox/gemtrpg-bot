# 秘密情報・設定
.env
.claude/
gemtrpgdicebot-*.json

# Node (フロントエンドビルド) — 成果物 static/dist は意図的にコミットする
node_modules/

# ローカル Python 仮想環境
.venv/

# データベース・キャッシュ
*.db
instance/
__pycache__/
*.pyc

# ローカル保存されていた古いデータ（念のため除外）
saved_rooms.json
battle_state.json

logs/json_rule_v2_audit.jsonl
logs/json_rule_v2_audit.jsonl.*

# Tailscale/Render local launch secrets and runtime data
GemDiceBot_Launch/config/*.local
GemDiceBot_Launch/config/*.local.*
GemDiceBot_Launch/config/*.env
GemDiceBot_Launch/runtime/

# Typst compiled output (regenerate with `typst compile`)
manuals/typst/build/

# 書籍制作の素材・スクリーンショット・表示確認画像（ローカル専用）
/typst_manual/_local/
# 配布用に名前を付けたPDF（scripts/build_publications.py が作る。Discordに置くファイル）
/output/release/
/tmp/pdfs/

# 説明動画のローカル確認とビルド成果物
/typst_manual/動画/_local/
/typst_manual/動画/**/out/
/typst_manual/動画/**/*.ega.html
/typst_manual/動画/**/audio/steps/
/typst_manual/動画/**/audio/manifest.json
/typst_manual/動画/**/voice/cache/
/typst_manual/動画/**/sfx/imported/

# 共通部品から生成するv2のビルド入力
/typst_manual/動画/01_1ラウンドの流れ/components/phase/
/typst_manual/動画/01_1ラウンドの流れ/components/dice/
/typst_manual/動画/01_1ラウンドの流れ/components/impact-hp/
/typst_manual/動画/01_1ラウンドの流れ/components/fp/
/typst_manual/動画/01_1ラウンドの流れ/components/effect-frame/
/typst_manual/動画/01_1ラウンドの流れ/components/background/
/typst_manual/動画/01_1ラウンドの流れ/components/gm-bubble/
/typst_manual/動画/01_1ラウンドの流れ/motion.css
/typst_manual/動画/01_1ラウンドの流れ/images/ruins-battle.png
